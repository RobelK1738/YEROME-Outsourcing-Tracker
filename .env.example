# ---------------------------------------------------------------------------
# Outsourcing Operations Dashboard — environment variables
#
# Production / Supabase / Vercel:
#   Copy this file to `.env` (or set the same keys in Vercel) and fill in values.
#   NEVER commit `.env`.
#
# Local SQLite development (no Supabase):
#   Use `.env.local` instead — copy from `.env.local.example`:
#     cp .env.local.example .env.local
#   Then run: ./runAppLocally.sh
# ---------------------------------------------------------------------------

# --- Frontend-safe (exposed to the browser via Vite) -----------------------
# These are safe to ship to the client. The publishable/anon key is protected
# by PostgreSQL Row Level Security and cannot read data the user is not allowed
# to see.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# --- Server-only (Vercel serverless functions / local scripts) -------------
# NEVER prefix these with VITE_ and NEVER expose them to the browser.
# The service-role key bypasses RLS and must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single email address permitted to operate as Admin.
ADMIN_EMAIL=admin@example.com

# Internal domain used to synthesize a deterministic Supabase Auth email from an
# Owner username (e.g. username "johnsmith" -> "johnsmith@owners.local").
# This is an implementation detail and is never shown in the Owner UI.
OWNER_AUTH_DOMAIN=owners.local

# --- Local scripts only ----------------------------------------------------
# Used once by `npm run bootstrap:admin` to set the initial Admin password.
# Do not set this in Vercel. Remove/rotate after bootstrapping if desired.
ADMIN_PASSWORD=change-me-strong-password

# Do NOT set VITE_BACKEND=local in production / Vercel.
# That switch is only for local SQLite mode (see .env.local.example).
